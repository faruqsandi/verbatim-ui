{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verbatim UI",
  "version": "0.1.0",
  "identifier": "com.bit.verbatimui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Verbatim UI",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost asset://localhost blob:; media-src 'self' asset: https://asset.localhost asset://localhost blob:; connect-src 'self' asset: https://asset.localhost asset://localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**/*", "$APPDATA/**/*"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}